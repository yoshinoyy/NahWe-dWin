# Supabase Postgres connection string for the Java backend.
# Example: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_DRIVER=org.postgresql.Driver

# Keep this server-side only. Never place it in Flutter or commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Flutter Web development origin. Update for your deployed web domain.
STEADY_ALLOWED_ORIGIN=http://localhost:3000
STEADY_PORT=8080
